.acard{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:14px;margin-top:10px}.grid>.acard{margin-top:0}
.astat{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:10px 0}.astat div{background:var(--surface2);border-radius:12px;padding:8px;text-align:center}.astat b{display:block;font-size:17px}.astat small{color:var(--muted);font-size:11px}
details.mg{margin-top:10px}details.mg summary{cursor:pointer;list-style:none;padding:10px 12px;border-radius:12px;background:var(--surface2);font-size:13px;font-weight:700;color:var(--muted)}details.mg summary::-webkit-details-marker{display:none}details.mg[open] summary{color:var(--text)}
.agrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.agrid .btn{padding:10px 6px;font-size:13px}
.cmp{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}.cmp>div{background:var(--surface2);border-radius:12px;padding:10px}.cmp small{display:block;color:var(--muted);font-size:11px}.cmp b{font-size:14px;overflow-wrap:anywhere}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.g2 label{font-size:12px;margin-top:6px}
.sw{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:13px 14px;margin-top:8px;font-size:14px;font-weight:600}.sw input{margin-left:auto;flex:0 0 20px}
.asec{margin:20px 2px 0;font-size:13px;font-weight:700;color:var(--muted)}
.ell{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
.hs{grid-template-columns:repeat(3,1fr)!important;gap:8px}.hs .sub{padding:10px}.head .btn{white-space:nowrap}@media(max-width:560px){.head #q-search{order:10;flex:1 1 100%;max-width:none}}
</style>
