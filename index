const F = {
  login: () => go(async () => {
    const u = val('f-user').toLowerCase();
    must(await sb.auth.signInWithPassword({ email: u + '@reelmate.app', password: $('f-pass').value }));
  }, 'เข้าสู่ระบบสำเร็จ', 'กำลังเข้าสู่ระบบ'),
  signup: () => {
    const name = val('f-name'), u = val('f-user').toLowerCase(), p = $('f-pass').value;
    if (!/^[a-z0-9._-]{3,30}$/.test(u)) { S.err = 'ชื่อผู้ใช้ 3–30 ตัว ใช้ a-z 0-9 . _ - เท่านั้น'; return render(); }
    if (p.length < 6) { S.err = 'รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร'; return render(); }
    if (p !== $('f-pass2').value) { S.err = 'รหัสผ่านไม่ตรงกัน'; return render(); }
    return go(async () => {
      const { data, error } = await sb.auth.signUp({ email: u + '@reelmate.app', password: p,
        options: { data: { username: u, display_name: name, platform_pref: S.splat, ref: S.ref || '' } } });
      if (error) throw error;
      if (!data.session) throw new Error('สมัครแล้ว แต่ระบบยังเปิดยืนยันอีเมลอยู่ — ให้แอดมินปิด “Confirm email” ใน Supabase Auth ก่อน');
      try { localStorage.removeItem('rm_ref'); S.ref = ''; } catch (e) {}
    }, 'สมัครสำเร็จ ยินดีต้อนรับ!');
  },
  help: form => go(async () => must(await sb.rpc('submit_help', { p_reel_id: form.dataset.id, p_typed: val('h-typed') })), 'ช่วยสำเร็จ!'),
  addnext: () => {
    const link = val('a-link');
    if (!REEL_RE.test(link)) { S.err = 'ลิงก์ไม่ถูกต้อง ต้องเป็นลิงก์ Reel ของ Facebook หรือ Instagram เท่านั้น'; return render(); }
    const platform = /instagram\.com|instagr\.am/i.test(link) ? 'Instagram' : 'Facebook';
    S.modal = { t: 'add', step: 2, link, platform, title: S.modal.title || `Reel จาก ${platform}`, cover: '', coverState: 'loading' }; S.err = ''; render(); loadCover();
  },
  add: () => {
    const link = S.modal.link, platform = S.modal.platform;
    if (!REEL_RE.test(link || '')) { S.err = 'ลิงก์ไม่ถูกต้อง'; S.modal.step = 1; return render(); }
    const cover = val('a-cover');
    return go(async () => must(await sb.rpc('create_reel', { p_title: val('a-title'), p_platform: platform, p_link: link, p_basket: val('a-basket'), p_cover: /^https:\/\//i.test(cover) ? cover : null })), 'โพสต์สำเร็จ รอเพื่อนมาช่วย');
  },
  edit: form => {
    const link = val('e-link');
    if (!REEL_RE.test(link)) { S.err = 'ลิงก์ไม่ถูกต้อง ต้องเป็นลิงก์ Reel ของ Facebook หรือ Instagram เท่านั้น'; return render(); }
    const cover = val('e-cover');
    return go(async () => must(await sb.rpc('update_my_reel', { p_id: form.dataset.id, p_title: val('e-title'), p_link: link, p_basket: val('e-basket'), p_cover: /^https:\/\//i.test(cover) ? cover : null })), 'แก้ไขคลิปแล้ว');
  },
  report: form => go(async () => must(await sb.from('reports').insert({ reporter_id: S.me.id, reel_id: form.dataset.id, reason: val('p-why') })), 'ส่งรายงานแล้ว'),
  credit: () => go(async () => must(await sb.rpc('admin_adjust_credit', { p_user: val('c-user'), p_kind: val('c-kind'), p_amount: Number(val('c-amt')), p_reason: val('c-why') })), 'ปรับเครดิตแล้ว'),
  settings: () => go(async () => {
    const patch = { updated_at: new Date().toISOString() };
    SET_FIELDS.forEach(([k]) => patch[k] = Number(val('s-' + k)));
    ['report_on', 'ig_follow_on', 'mode200_enabled', 'auto_approve_exact'].forEach(k => patch[k] = $('s-' + k).checked);
    must(await sb.from('settings').update(patch).eq('id', 1));
  }, 'บันทึกการตั้งค่าแล้ว')
};
document.addEventListener('input', e => { const k = { 'q-search': 'q', 'u-search': 'uq' }[e.target.id]; if (!k) return; const id = e.target.id; S[k] = e.target.value; render(); const el = $(id); if (el) { el.focus(); el.setSelectionRange(el.value.length, el.value.length); } });
document.addEventListener('submit', e => {
  const form = e.target.closest('[data-form]'); if (!form) return;
  e.preventDefault();
  const fn = F[form.dataset.form]; if (fn) fn(form);
});

// ห้ามเรียก supabase แบบ await ตรงๆ ใน callback นี้ (อาจ deadlock) จึงเลื่อนไปรอบถัดไป
sb.auth.onAuthStateChange((ev) => { if (ev === 'SIGNED_OUT') setTimeout(load, 0); });
load().catch(e => { S.ready = true; S.err = niceErr(e); render(); });
</script>
</body>
