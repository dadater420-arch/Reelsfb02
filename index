function render() {
  const active = document.activeElement?.id;
  const keep = {};
  document.querySelectorAll('#app input[id],#app textarea[id],#app select[id]').forEach(i => { keep[i.id] = i.type === 'checkbox' ? i.checked : i.value; });
  $('app').innerHTML = !S.ready ? '<div class="auth muted">กำลังโหลด…</div>' : !S.me ? view.auth() : view.app() + view.modal();
  for (const id in keep) { const el = $(id); if (!el) continue; if (el.type === 'checkbox') el.checked = keep[id]; else el.value = keep[id]; }
  document.querySelectorAll('#app .tabs').forEach(t => { const b = t.querySelector('button.on'); if (b) t.scrollLeft = b.offsetLeft - (t.clientWidth - b.offsetWidth) / 2; });
  if (active && $(active)) $(active).focus();
}

