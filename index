.warn{background:#f59e0b18;border:1px solid #f59e0b55;color:#fcd34d;border-radius:16px;padding:12px 14px;font-size:13px;font-weight:600;margin-top:12px}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#0b2a17;border:1px solid #22c55e66;padding:12px 18px;border-radius:14px;z-index:99;font-weight:600;max-width:90vw}
