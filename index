.topbar{position:fixed;left:0;top:0;height:3px;width:100%;z-index:300;background:linear-gradient(90deg,transparent,#4d9bff,#22d3ee,transparent) no-repeat;background-size:50% 100%;animation:bar 1s linear infinite}
