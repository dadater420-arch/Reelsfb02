<style>
:root{--bg:#0a0d13;--surface:#12161f;--surface2:#171c28;--surface3:#1e2534;--line:#242c3d;--text:#eef2f8;--muted:#9aa7bd;--primary:#2f7dff;--primary2:#4d9bff;--green:#22c55e;--amber:#f59e0b;--red:#ef4444;--cyan:#22d3ee}
