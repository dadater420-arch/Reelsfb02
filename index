<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js" crossorigin="anonymous"></script>
<script>
'use strict';
/* ============ ตั้งค่า (publishable key เปิดเผยได้ ความปลอดภัยอยู่ที่ RLS ฝั่งฐานข้อมูล) ============ */
const SB_URL = 'https://hajdefougllyugmamwdn.supabase.co';
const SB_KEY = 'sb_publishable_nfamPECiovzrLjkzPtTOJg_E9MDNb75';
const sb = window.supabase.createClient(SB_URL, SB_KEY, { auth: { persistSession: true, autoRefreshToken: true } });

/* ============ ตัวช่วย ============ */
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safeUrl = u => /^https?:\/\//i.test(u || '') ? esc(u) : '#';
const httpsUrl = u => /^https:\/\//i.test(u || '') ? esc(u) : '';
const REEL_RE = /^https?:\/\/([a-z0-9-]+\.)*(facebook\.com|fb\.watch|fb\.com|fb\.gg|instagram\.com|instagr\.am)(\/|$)/i;
const fmt = d => new Date(d).toLocaleString('th-TH', {day:'numeric', month:'short', hour:'2-digit', minute:'2-digit'});
const today = () => new Intl.DateTimeFormat('en-CA', {timeZone:'Asia/Bangkok'}).format(new Date());
const code = p => 'RM' + String(p.member_no).padStart(3, '0');
const ini = s => (s || '?').trim().slice(0, 1).toUpperCase();
const GRAD = ['#2563eb,#06b6d4','#7c3aed,#db2777','#059669,#14b8a6','#ea580c,#f43f5e','#1d4ed8,#7c3aed'];
const grad = s => { let h = 0; for (const c of String(s)) h = (h * 31 + c.charCodeAt(0)) >>> 0; return `linear-gradient(135deg,${GRAD[h % GRAD.length]})`; };
const pct = (a, b) => Math.min(100, Math.round(a / Math.max(1, b) * 100));
const $ = id => document.getElementById(id);
const val = id => ($(id)?.value ?? '').trim();

let tt; function toast(msg, bad) {
  $('toast').innerHTML = `<div class="toast ${bad ? 'bad' : ''}">${esc(msg)}</div>`;
  clearTimeout(tt); tt = setTimeout(() => $('toast').innerHTML = '', 3500);
}
const niceErr = e => {
  const m = e?.message || String(e);
  if (/Invalid login/i.test(m)) return 'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง';
  if (/already registered|duplicate key|profiles_username_key/i.test(m)) return 'ชื่อผู้ใช้นี้มีคนใช้แล้ว';
  if (/rate limit|too many/i.test(m)) return 'ลองบ่อยเกินไป รอสักครู่แล้วลองใหม่';
  if (/Password should/i.test(m)) return 'รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร';
  return m;
};

/* ============ ดึงรูปปกจากลิงก์ Reel (ผ่าน microlink) ============ */
async function fetchCover(link) {
  const ctl = new AbortController(); const t = setTimeout(() => ctl.abort(), 9000);
  try {
    const r = await fetch('https://api.microlink.io/?url=' + encodeURIComponent(link), { signal: ctl.signal });
    if (!r.ok) return null;
    const j = await r.json();
    const u = j?.data?.image?.url || j?.data?.screenshot?.url || '';
    return /^https:\/\//i.test(u) ? u : null;
  } catch { return null; } finally { clearTimeout(t); }
}
async function loadCover(force) {
  const m = S.modal; if (!m || m.t !== 'add') return;
  const link = m.link; m.coverState = 'loading'; render();
  const url = await fetchCover(link);
  if (S.modal !== m || m.step !== 2) return;
  const typed = val('a-cover'), old = m.cover;
  m.coverState = url ? 'ok' : 'fail'; if (url) m.cover = url;
  render();
  if (url && (!typed || typed === old) && $('a-cover')) $('a-cover').value = url;
}

/* ============ สถานะ ============ */
const S = { ready:false, mode:'login', me:null, set:null, tab:'feed', atab:'overview', platform:'ทั้งหมด',
  feed:[], myReels:[], myHelps:[], board:[], gate:null, modal:null, adm:null, busy:false, err:'', q:'', uq:'', uf:'all', hf:'รอตรวจ', rf:'รอตรวจสอบ', showpw:false, splat:'ทั้ง 2 อย่าง' };
try { S.guideHidden = localStorage.getItem('rm_guide_hidden') === '1'; } catch (e) { S.guideHidden = false; }
try { const q = new URLSearchParams(location.search).get('ref'); if (q && /^[A-Za-z]{0,3}\d{1,6}$/.test(q)) { localStorage.setItem('rm_ref', q.toUpperCase()); S.mode = 'signup'; } } catch (e) {}
try { S.ref = localStorage.getItem('rm_ref') || ''; } catch (e) { S.ref = ''; }
const inviteLink = () => location.origin + location.pathname + '?ref=' + code(S.me);

/* ============ โหลดข้อมูล ============ */
async function load() {
  const { data: { session } } = await sb.auth.getSession();
  if (!session) { S.me = null; S.ready = true; return render(); }
  const uid = session.user.id;
  const [me, set, feed, mine, helps, board, gate, invites] = await Promise.all([
    sb.from('profiles').select('*').eq('id', uid).maybeSingle(),
    sb.from('settings').select('*').eq('id', 1).single(),
    sb.rpc('get_feed', { p_platform: S.platform === 'ทั้งหมด' ? null : S.platform }),
    sb.from('reels').select('*').eq('owner_id', uid).order('posted_at', { ascending: false }),
    sb.from('helps').select('id,reel_id,clip_title,typed,status,helped_date,created_at').eq('helper_id', uid).order('created_at', { ascending: false }).limit(50),
    sb.rpc('get_leaderboard'),
    sb.rpc('can_post_reel'),
    sb.rpc('get_my_invites')
  ]);
  if (!me.data) { await sb.auth.signOut(); S.me = null; S.ready = true; return render(); }
  Object.assign(S, { me: me.data, set: set.data, feed: feed.data || [], myReels: mine.data || [],
    myHelps: helps.data || [], board: board.data || [], gate: gate.data, invites: invites.data || [], ready: true });
  try { const pend = JSON.parse(sessionStorage.getItem('rm_help_pending') || 'null'); sessionStorage.removeItem('rm_help_pending');
    if (pend && Date.now() - pend.t < 900000 && !S.modal && S.feed.some(x => x.id === pend.id)) S.modal = { t: 'help', id: pend.id, step: 2 }; } catch (e) {}
  if (S.me.role === 'admin' && S.tab === 'admin') await loadAdmin();
  render();
}
async function loadAdmin() {
  const [users, reels, helps, reports, credits] = await Promise.all([
    sb.from('profiles').select('*').order('member_no', { ascending: false }).limit(500),
    sb.from('reels').select('*,profiles(display_name)').order('posted_at', { ascending: false }).limit(200),
    sb.from('helps').select('*,profiles(display_name)').order('created_at', { ascending: false }).limit(200),
    sb.from('reports').select('*,profiles(display_name),reels(title,link)').order('created_at', { ascending: false }).limit(200),
    sb.from('credit_logs').select('*,profiles!credit_logs_user_id_fkey(display_name)').order('created_at', { ascending: false }).limit(100)
  ]);
  S.adm = { users: users.data || [], reels: reels.data || [], helps: helps.data || [], reports: reports.data || [], credits: credits.data || [] };
}
/* ============ ป๊อปอัพแสดงความคืบหน้า ============ */
const TITLES = {
  'อัปเดตสถานะแล้ว':'กำลังอัปเดตสถานะผู้ใช้','เพิ่มใบเตือนแล้ว':'กำลังเพิ่มใบเตือน','อัปเดตแล้ว':'กำลังอัปเดตข้อมูล',
  'อัปเดตป้ายแล้ว':'กำลังอัปเดตป้าย','อัปเดตคลิปแล้ว':'กำลังอัปเดตคลิป','ลบคลิปแล้ว':'กำลังลบคลิป',
  'อนุมัติแล้ว':'กำลังอนุมัติ','ปฏิเสธแล้ว':'กำลังปฏิเสธ','ตัดเครดิตแล้ว':'กำลังตัดเครดิต','บันทึกแล้ว':'กำลังบันทึก','แก้ไขคลิปแล้ว':'กำลังบันทึกการแก้ไข','แลกบัตรสำเร็จ':'กำลังแลกบัตร','ดันคลิปขึ้นใหม่แล้ว':'กำลังดันคลิปขึ้นใหม่',
  'พักคลิปแล้ว':'กำลังพักคลิป','ลบรายงานแล้ว':'กำลังลบรายงาน','สมัครสำเร็จ ยินดีต้อนรับ!':'กำลังสมัครสมาชิก',
  'ช่วยสำเร็จ!':'กำลังบันทึกการช่วย','โพสต์สำเร็จ รอเพื่อนมาช่วย':'กำลังโพสต์คลิป','ส่งรายงานแล้ว':'กำลังส่งรายงาน',
  'ปรับเครดิตแล้ว':'กำลังปรับเครดิต','บันทึกการตั้งค่าแล้ว':'กำลังบันทึกการตั้งค่า'
};
const Prog = {
  slowT:null, quiet:false,
  open(title, steps, quiet) {
    clearTimeout(this.slowT); this.quiet = !!quiet;
    document.body.classList.add('busy');
    $('prog').innerHTML = `<div class="topbar"></div><div class="bchip"><div class="spin"></div><span id="btxt">${esc(title)}…</span></div>`;
    this.slowT = setTimeout(() => { const t = $('btxt'); if (t) t.textContent = 'เครือข่ายช้ากว่าปกติ รอสักครู่ อย่ากดซ้ำ…'; }, 8000);
  },
  step() {},
  finish(msg) { this.close(); if (msg && !this.quiet) toast(msg); },
  fail() { this.close(); },
  close() { clearTimeout(this.slowT); document.body.classList.remove('busy'); $('prog').innerHTML = ''; }
};
const withTimeout = (p, ms = 30000) => Promise.race([p, new Promise((_, rj) => setTimeout(() => rj(new Error('ใช้เวลานานเกินไป ตรวจสอบอินเทอร์เน็ตแล้วลองใหม่')), ms))]);

async function go(fn, okMsg, title) {
  if (S.busy) { toast('กำลังดำเนินการอยู่ กรุณารอสักครู่', true); return; }
  S.busy = true;
  Prog.open(title || TITLES[okMsg] || 'กำลังดำเนินการ', ['ส่งคำขอไปยังเซิร์ฟเวอร์', 'บันทึกข้อมูลแล้ว', 'โหลดข้อมูลล่าสุด']);
  try {
    await withTimeout(fn());
    Prog.step(1); S.modal = null; S.err = ''; try { sessionStorage.removeItem('rm_help_pending'); } catch (e) {}
    Prog.step(2); await withTimeout(load());
    Prog.finish(okMsg || 'เสร็จเรียบร้อย');
  } catch (e) { S.err = niceErr(e); Prog.fail(niceErr(e)); toast(niceErr(e), true); render(); }
  finally { S.busy = false; if (!S.me) render(); }
}
/* งานโหลดข้อมูลทั่วไป (สลับแท็บ/ตัวกรอง/ออกจากระบบ) พร้อมป๊อปอัพ */
async function quick(title, fn) {
  if (S.busy) { toast('กำลังดำเนินการอยู่ กรุณารอสักครู่', true); return; }
  S.busy = true; Prog.open(title, [], true);
  try { await withTimeout(fn()); Prog.step(1); render(); Prog.finish('เรียบร้อย'); }
  catch (e) { Prog.fail(niceErr(e)); toast(niceErr(e), true); }
  finally { S.busy = false; if (!S.me) render(); }
}
